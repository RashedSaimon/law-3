<%- include('partials/header') %>

<section class="admin-card">
  <div class="card-heading">
    <div>
      <p>Website content</p>
      <h2><%= config.label %></h2>
    </div>
    <a class="primary-link" href="/admin/content.php?type=<%= type %>&action=new">+ Add new</a>
  </div>
  <% if (rows && rows.length > 0) { %>
    <div class="data-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Details</th>
            <th>Visibility</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(row => { %>
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <% if (row.icon && typeof renderMenuIcon === 'function') { %>
                    <span class="table-icon-preview"><%- renderMenuIcon(row.icon) %></span>
                  <% } %>
                  <strong><%= row.title || row.label || row.name || row.client_name || row.eyebrow || 'Untitled' %></strong>
                </div>
              </td>
              <td>
                <% if (type === 'pages') { %>
                  <% 
                    const isLayer3 = row.parent_page_id && Number(row.parent_page_id) > 0;
                    const parentPageObj = isLayer3 && typeof allPages !== 'undefined' ? allPages.find(p => Number(p.id) === Number(row.parent_page_id)) : null;
                  %>
                  <div style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center;">
                    <% if (row.parent_menu === 'personal_immigration') { %>
                      <span class="badge-category">Personal Immigration (L1)</span>
                    <% } else if (row.parent_menu === 'business_immigrations') { %>
                      <span class="badge-category">Business Immigration (L1)</span>
                    <% } else { %>
                      <span class="badge-category subtle">Standalone / Footer</span>
                    <% } %>

                    <% if (isLayer3) { %>
                      <span class="badge-category" style="background: #eef2f3; color: #355355; border: 1px solid #ccd6d7;">
                        ↳ Layer 3 under: <strong><%= parentPageObj ? parentPageObj.title : 'ID ' + row.parent_page_id %></strong>
                      </span>
                    <% } else if (row.parent_menu !== 'none') { %>
                      <span class="badge-category" style="background: #fdf5e6; color: #8f6e37; border: 1px solid #e7d6b3;">
                        ★ Layer 2 Category
                      </span>
                    <% } %>
                  </div>
                  <small style="margin-top: 4px; display: block; color: #788a8b;">/page.php?slug=<%= row.slug %></small>
                <% } else if (type === 'menus') { %>
                  <small style="font-weight: 600; color: #173537;"><%= row.url %></small>
                  <small style="color: #788a8b; display: block;">Order: <%= row.sort_order || 0 %></small>
                <% } else { %>
                  <small><%= row.tagline || row.role || row.category || row.client_role || row.section_key || row.slug || row.text || '' %></small>
                <% } %>
              </td>
              <td>
                <% if (type === 'articles' || type === 'pages') { %>
                  <span class="pill <%= row.status %>"><%= row.status.charAt(0).toUpperCase() + row.status.slice(1) %></span>
                <% } else { %>
                  <span class="pill <%= row.is_active ? 'active' : 'closed' %>"><%= row.is_active ? 'Visible' : 'Hidden' %></span>
                <% } %>
              </td>
              <td class="actions">
                <a href="/admin/content.php?type=<%= type %>&action=edit&id=<%= row.id %>">Edit</a>
                <button type="button" class="btn-delete-trigger" onclick="openDeleteModal('<%= type %>', '<%= row.id %>', '<%= (row.title || row.label || row.name || row.client_name || row.eyebrow || 'item').replace(/'/g, "\\'") %>')">Delete</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty">No items found in this section. Click "+ Add new" to create one.</div>
  <% } %>
</section>

<!-- Custom Delete Confirmation Modal (Iframe-safe) -->
<div id="deleteModal" class="admin-modal-backdrop" style="display:none;" onclick="if(event.target===this) closeDeleteModal()">
  <div class="admin-modal-card">
    <div class="admin-modal-header">
      <h3>Confirm Deletion</h3>
      <button type="button" class="modal-close-btn" onclick="closeDeleteModal()">&times;</button>
    </div>
    <div class="admin-modal-body">
      <p>Are you sure you want to permanently delete <strong id="deleteItemTitle">this item</strong>?</p>
      <small style="display:block; margin-top: 8px; color: #788a8b;">This will remove the item from the live website and database.</small>
    </div>
    <div class="admin-modal-footer">
      <button type="button" class="modal-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
      <form id="deleteModalForm" method="post" action="/admin/content.php?type=<%= type %>" style="margin: 0;">
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="type" id="modalDeleteType" value="<%= type %>">
        <input type="hidden" name="id" id="modalDeleteId" value="">
        <button type="submit" class="modal-btn-confirm">Yes, Delete Item</button>
      </form>
    </div>
  </div>
</div>

<script>
  function openDeleteModal(type, id, title) {
    var modal = document.getElementById('deleteModal');
    var form = document.getElementById('deleteModalForm');
    var titleEl = document.getElementById('deleteItemTitle');
    var idInput = document.getElementById('modalDeleteId');
    var typeInput = document.getElementById('modalDeleteType');

    if (modal && form && idInput) {
      form.action = '/admin/content.php?type=' + encodeURIComponent(type);
      if (titleEl) titleEl.textContent = '"' + title + '"';
      idInput.value = id;
      if (typeInput) typeInput.value = type;
      modal.style.display = 'flex';
    }
  }

  function closeDeleteModal() {
    var modal = document.getElementById('deleteModal');
    if (modal) {
      modal.style.display = 'none';
    }
  }

  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeDeleteModal();
    }
  });
</script>

<%- include('partials/footer') %>
