<%- include('partials/header') %>

<section class="admin-card">
  <div class="card-heading">
    <div>
      <p>Contact-form submissions</p>
      <h2>All enquiries</h2>
    </div>
  </div>
  <% if (enquiries && enquiries.length > 0) { %>
    <div class="data-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Client</th>
            <th>Contact</th>
            <th>Service & message</th>
            <th>Received</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% enquiries.forEach(row => { %>
            <tr>
              <td><strong><%= row.first_name %> <%= row.last_name %></strong></td>
              <td>
                <small>
                  <%= row.email %><br>
                  <%= row.phone || '' %>
                </small>
              </td>
              <td>
                <strong><%= row.service || 'General enquiry' %></strong>
                <small class="message-preview"><%= row.message %></small>
              </td>
              <td><%= row.created_at %></td>
              <td>
                <form class="status-form" method="post" action="/admin/content.php?type=enquiries">
                  <input type="hidden" name="action" value="status">
                  <input type="hidden" name="id" value="<%= row.id %>">
                  <select name="status" onchange="this.form.submit()">
                    <% ['new', 'contacted', 'closed'].forEach(s => { %>
                      <option value="<%= s %>" <%= row.status === s ? 'selected' : '' %>><%= s %></option>
                    <% }); %>
                  </select>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty">No enquiries recorded yet.</div>
  <% } %>
</section>

<%- include('partials/footer') %>
