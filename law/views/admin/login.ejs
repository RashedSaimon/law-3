<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <script>
    (function() {
      try {
        var rawFetch = window.fetch ? window.fetch.bind(window) : null;
        var currentFetch = rawFetch;
        var defineSafeProperty = function(target) {
          if (!target) return;
          try {
            var desc = Object.getOwnPropertyDescriptor(target, 'fetch');
            if (!desc || desc.configurable) {
              Object.defineProperty(target, 'fetch', {
                get: function() { return currentFetch; },
                set: function(val) { currentFetch = val; },
                configurable: true,
                enumerable: true
              });
            }
          } catch (e) {}
        };
        defineSafeProperty(window);
        if (typeof Window !== 'undefined' && Window.prototype) {
          defineSafeProperty(Window.prototype);
        }
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Admin login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body class="login-body">
  <main class="login-card">
    <a class="admin-brand dark" href="/">
      <span>N</span> NORTHSTAR
    </a>
    <p class="admin-label">SECURE ADMINISTRATION</p>
    <h1>Welcome back.</h1>
    <p>Sign in to manage your website content.</p>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="post" action="/admin/login.php">
      <label>Email address
        <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : 'admin@example.com' %>" required autofocus>
      </label>
      <label>Password
        <input type="password" name="password" value="ChangeMe123!" required>
      </label>
      <button type="submit">Sign in <span>→</span></button>
    </form>
    <small>Initial login: admin@example.com / ChangeMe123!</small>
  </main>
</body>
</html>
