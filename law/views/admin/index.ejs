<%- include('partials/header') %>

<section class="metrics">
  <% counts.forEach(metric => { %>
    <article>
      <span><%= metric.label %></span>
      <strong><%= metric.count %></strong>
      <a href="/admin/content.php?type=<%= metric.type %>">Manage →</a>
    </article>
  <% }); %>
</section>

<section class="admin-card">
  <div class="card-heading">
    <div>
      <p>Latest leads</p>
      <h2>Recent enquiries</h2>
    </div>
    <a href="/admin/content.php?type=enquiries">View all →</a>
  </div>
  <% if (enquiries && enquiries.length > 0) { %>
    <div class="data-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Client</th>
            <th>Service</th>
            <th>Received</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% enquiries.forEach(row => { %>
            <tr>
              <td>
                <strong><%= row.first_name %> <%= row.last_name %></strong>
                <small><%= row.email %></small>
              </td>
              <td><%= row.service || 'General enquiry' %></td>
              <td><%= row.created_at %></td>
              <td>
                <span class="pill <%= row.status %>"><%= row.status.charAt(0).toUpperCase() + row.status.slice(1) %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty">No enquiries yet. Contact form leads will appear here.</div>
  <% } %>
</section>

<section class="quick-actions">
  <a href="/admin/content.php?type=articles&action=new">+ Write article</a>
  <a href="/admin/content.php?type=services&action=new">+ Add service</a>
  <a href="/admin/content.php?type=settings">⚙ Update site settings</a>
</section>

<%- include('partials/footer') %>
