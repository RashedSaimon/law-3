<%- include('partials/header') %>

<section class="hero-slider" data-hero-slider aria-label="Featured messages">
  <% if (hero_slides && hero_slides.length > 0) { %>
    <% hero_slides.forEach((slide, index) => { %>
      <article class="hero hero-slide<%= index === 0 ? ' active' : '' %>" <%= slide.image_path ? `style="--hero-image: url('${slide.image_path}')"` : '' %>>
        <div class="hero-overlay"></div>
        <div class="container hero-content">
          <p class="eyebrow"><%= slide.eyebrow %></p>
          <h1><%- slide.title.replace(/\n/g, '<br>') %></h1>
          <p class="hero-copy"><%= slide.text %></p>
          <a class="btn hero-button" href="<%= slide.button_url || '/contact.php#consultation' %>"><%= slide.button_text || 'Book consultation' %> <span>↗</span></a>
        </div>
      </article>
    <% }); %>
    <div class="container hero-slider-ui">
      <div class="hero-dots">
        <% hero_slides.forEach((slide, index) => { %>
          <button class="<%= index === 0 ? 'active' : '' %>" data-hero-dot="<%= index %>" aria-label="Show slide <%= index + 1 %>"></button>
        <% }); %>
      </div>
      <div class="hero-note">Scroll to explore <span></span></div>
    </div>
  <% } else { %>
    <article class="hero hero-slide active">
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <p class="eyebrow">IMMIGRATION SPECIALISTS</p>
        <h1><%- setting('hero_title', "From paperwork to possibilities.\nWe've got you covered.").replace(/\n/g, '<br>') %></h1>
        <p class="hero-copy"><%= setting('hero_text', 'Clear advice, experienced guidance and a plan tailored around you.') %></p>
        <a class="btn hero-button" href="/contact.php#consultation">Book consultation <span>↗</span></a>
      </div>
    </article>
  <% } %>
</section>

<section class="stats">
  <div class="container stats-grid">
    <% [
      ['stat_consultations', 'Free consultations', '01'],
      ['stat_cases', 'Active cases', '02'],
      ['stat_success', 'Success rate', '03'],
      ['stat_reviews', 'Client reviews', '04']
    ].forEach(([key, label, num]) => { %>
      <div class="stat">
        <span class="stat-number"><%= setting(key, '100') %><b><%= key === 'stat_success' ? '%' : '+' %></b></span>
        <span><%= label %></span>
        <i><%= num %></i>
      </div>
    <% }); %>
  </div>
</section>

<section class="intro section section-image"<%- sectionStyle('home_intro') %>>
  <div class="container two-col">
    <div>
      <p class="eyebrow">Welcome to</p>
      <h2><%= setting('intro_heading', 'Northstar Legal') %></h2>
    </div>
    <div>
      <p class="lead"><%= setting('intro_text', 'We make immigration processes feel manageable. Our team combines technical excellence with thoughtful, one-to-one guidance from your first conversation to the final decision.') %></p>
      <a class="text-link" href="/about.php">Meet our team <span>↗</span></a>
    </div>
  </div>
</section>

<section class="feature-section section section-image"<%- sectionStyle('home_features') %>>
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">The Northstar difference</p>
      <h2>Why clients choose <em>us.</em></h2>
    </div>
    <div class="features">
      <% services.slice(0, 4).forEach((service, i) => { %>
        <article class="feature">
          <span>0<%= i + 1 %></span>
          <h3><%= service.title %></h3>
          <p><%= service.excerpt %></p>
          <a href="/services.php#service-<%= service.id %>">Explore <b>↗</b></a>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="testimonials section section-image"<%- sectionStyle('home_testimonials') %>>
  <div class="container">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Client stories</p>
        <h2>Trusted when it<br><em>matters most.</em></h2>
      </div>
      <div class="slider-controls">
        <button class="slider-prev" aria-label="Previous">←</button>
        <button class="slider-next" aria-label="Next">→</button>
      </div>
    </div>
    <div class="testimonial-track">
      <% testimonials.forEach(testimonial => { %>
        <article class="testimonial">
          <div class="quote-mark">“</div>
          <p><%= testimonial.quote %></p>
          <div class="person">
            <% if (testimonial.image_path) { %>
              <img src="<%= testimonial.image_path %>" alt="<%= testimonial.client_name %>">
            <% } else { %>
              <span><%= testimonial.client_name.substring(0, 1).toUpperCase() %></span>
            <% } %>
            <div>
              <strong><%= testimonial.client_name %></strong>
              <small><%= testimonial.client_role %></small>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="articles section section-image"<%- sectionStyle('home_articles') %>>
  <div class="container">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Latest articles</p>
        <h2>Expert comment<br><em>& insight.</em></h2>
      </div>
      <a class="text-link" href="/articles.php">All insights <span>↗</span></a>
    </div>
    <div class="article-grid">
      <% articles.forEach(article => { %>
        <article class="article-card">
          <% if (article.image_path) { %>
            <img src="<%= article.image_path %>" alt="">
          <% } else { %>
            <div class="article-image">
              <span><%= formatShortDate(article.published_at) %></span>
            </div>
          <% } %>
          <p class="article-meta"><%= article.category %> · <%= formatDate(article.published_at) %></p>
          <h3><%= article.title %></h3>
          <p><%= article.excerpt %></p>
          <a class="text-link" href="/article.php?slug=<%= encodeURIComponent(article.slug) %>">Read more <span>↗</span></a>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
