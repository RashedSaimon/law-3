<%- include('partials/header') %>

<article class="article-page">
  <div class="container article-content">
    <a class="back-link" href="/articles.php">← All insights</a>
    <p class="eyebrow"><%= article.category %> · <%= formatDate(article.published_at) %></p>
    <h1><%= article.title %></h1>
    <p class="article-standfirst"><%= article.excerpt %></p>
    <% if (article.image_path) { %>
      <img class="article-hero-image" src="<%= article.image_path %>" alt="">
    <% } %>
    <div class="prose">
      <%- article.body.replace(/\n/g, '<br>') %>
    </div>
  </div>
</article>

<%- include('partials/footer') %>
