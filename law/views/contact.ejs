<%- include('partials/header') %>

<section class="inner-hero contact-hero section-image"<%- sectionStyle('contact_hero') %>>
  <div class="container">
    <p class="eyebrow">Contact us</p>
    <h1>Your case matters.<br><em>Let’s talk.</em></h1>
    <p>Tell us a little about your situation and the right person will get in touch.</p>
  </div>
</section>

<section class="section section-image" id="consultation"<%- sectionStyle('contact_form') %>>
  <div class="container contact-grid">
    <div>
      <p class="eyebrow">Make an appointment</p>
      <h2>Start with a<br><em>conversation.</em></h2>
      <div class="contact-details">
        <a href="tel:<%= setting('phone', '+44 20 0000 0000').replace(/\s+/g, '') %>">
          <b>Call</b><%= setting('phone', '+44 20 0000 0000') %>
        </a>
        <a href="mailto:<%= setting('email', 'hello@northstarlegal.co.uk') %>">
          <b>Email</b><%= setting('email', 'hello@northstarlegal.co.uk') %>
        </a>
        <p>
          <b>Visit</b><%- setting('address', '20 Example Street\nLondon, United Kingdom').replace(/\n/g, '<br>') %>
        </p>
      </div>
    </div>
    <form class="contact-form" action="/submit.php" method="post">
      <input type="hidden" name="form_type" value="consultation">
      <label>First name
        <input required name="first_name" autocomplete="given-name">
      </label>
      <label>Last name
        <input required name="last_name" autocomplete="family-name">
      </label>
      <label>Email address
        <input required type="email" name="email" autocomplete="email">
      </label>
      <label>Phone number
        <input name="phone" autocomplete="tel">
      </label>
      <label>How can we help?
        <select name="service">
          <option value="">Select a service</option>
          <% services.forEach(service => { %>
            <option value="<%= service.title %>" <%= topic === service.title ? 'selected' : '' %>><%= service.title %></option>
          <% }); %>
        </select>
      </label>
      <label class="full">Tell us more
        <textarea required name="message" rows="5" placeholder="Briefly describe your situation"></textarea>
      </label>
      <label class="consent full">
        <input required type="checkbox" name="consent" value="1">
        <span>I agree that my details may be used to respond to this enquiry.</span>
      </label>
      <button class="btn" type="submit">Send enquiry <span>↗</span></button>
    </form>
  </div>
</section>

<% if (typeof sent !== 'undefined' && sent) { %>
  <div class="toast">Thank you—your enquiry has been received.</div>
<% } %>

<%- include('partials/footer') %>
