<%- include('partials/header') %>

<% if (typeof hero_slides !== 'undefined' && hero_slides && hero_slides.length > 0) { %>
  <section class="hero-slider">
    <% hero_slides.forEach((slide, idx) => { %>
      <div class="hero-slide <%= idx === 0 ? 'active' : '' %>" <%= slide.image_path ? `style="--hero-image: url('${slide.image_path}')"` : '' %>>
        <div class="hero-overlay"></div>
        <div class="container">
          <div class="hero-content">
            <p class="eyebrow"><%= slide.eyebrow || setting('site_name', 'Northstar Legal') %></p>
            <h1><%- slide.title || setting('hero_title', "From paperwork to possibilities.\nWe've got you covered.") %></h1>
            <p class="hero-copy"><%= slide.text || setting('hero_text', 'Professional, straightforward legal representation across personal and business immigration routes.') %></p>
            <div class="hero-interactive-row">
              <div class="hero-dropdown-wrapper">
                <button type="button" class="hero-dropdown-box" id="heroDropdownBtn-<%= slide.id %>" aria-expanded="false" aria-haspopup="listbox">
                  <span class="hero-dropdown-text"><%= setting('hero_dropdown_placeholder', 'What can we help you with?') %></span>
                  <span class="hero-dropdown-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </button>
                <div class="hero-dropdown-menu" role="listbox">
                  <% if (typeof hero_dropdown !== 'undefined' && hero_dropdown && hero_dropdown.length > 0) { %>
                    <% hero_dropdown.forEach(item => { %>
                      <a href="<%= item.resolved_url || '#' %>" class="hero-dropdown-option" role="option">
                        <span><%= item.title %></span>
                      </a>
                    <% }); %>
                  <% } else { %>
                    <a href="/page.php?slug=spouse-partner-visas" class="hero-dropdown-option" role="option"><span>Spouse visa</span></a>
                    <a href="/page.php?slug=fiance-visa" class="hero-dropdown-option" role="option"><span>Finance visa</span></a>
                    <a href="/page.php?slug=graduate-route" class="hero-dropdown-option" role="option"><span>Graduate visa</span></a>
                    <a href="/page.php?slug=human-rights-claims" class="hero-dropdown-option" role="option"><span>Human right</span></a>
                  <% } %>
                </div>
              </div>

              <a href="<%= slide.button_url || '/contact.php#consultation' %>" class="btn hero-cta-btn" id="hero-cta-<%= slide.id %>">
                <span><%= slide.button_text || 'Book consultation' %></span> <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }); %>

    <% if (hero_slides.length > 1) { %>
      <div class="container hero-slider-ui">
        <div class="hero-dots">
          <% hero_slides.forEach((_, idx) => { %>
            <button class="<%= idx === 0 ? 'active' : '' %>" aria-label="Go to slide <%= idx + 1 %>"></button>
          <% }); %>
        </div>
      </div>
    <% } %>
  </section>
<% } else { %>
  <section class="hero"<%- sectionStyle('home_hero') %>>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <p class="eyebrow"><%= setting('site_name', 'Northstar Legal') %> Practice</p>
        <h1><%- setting('hero_title', "From paperwork to possibilities.\nWe've got you covered.") %></h1>
        <p class="hero-copy"><%= setting('hero_text', 'Professional, straightforward legal representation across personal and business immigration routes.') %></p>
        <div class="hero-interactive-row">
          <div class="hero-dropdown-wrapper">
            <button type="button" class="hero-dropdown-box" id="heroDropdownBtn-fallback" aria-expanded="false" aria-haspopup="listbox">
              <span class="hero-dropdown-text"><%= setting('hero_dropdown_placeholder', 'What can we help you with?') %></span>
              <span class="hero-dropdown-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="hero-dropdown-menu" role="listbox">
              <% if (typeof hero_dropdown !== 'undefined' && hero_dropdown && hero_dropdown.length > 0) { %>
                <% hero_dropdown.forEach(item => { %>
                  <a href="<%= item.resolved_url || '#' %>" class="hero-dropdown-option" role="option">
                    <span><%= item.title %></span>
                  </a>
                <% }); %>
              <% } else { %>
                <a href="/page.php?slug=spouse-partner-visas" class="hero-dropdown-option" role="option"><span>Spouse visa</span></a>
                <a href="/page.php?slug=fiance-visa" class="hero-dropdown-option" role="option"><span>Finance visa</span></a>
                <a href="/page.php?slug=graduate-route" class="hero-dropdown-option" role="option"><span>Graduate visa</span></a>
                <a href="/page.php?slug=human-rights-claims" class="hero-dropdown-option" role="option"><span>Human right</span></a>
              <% } %>
            </div>
          </div>

          <a href="/contact.php#consultation" class="btn hero-cta-btn">
            <span>Book consultation</span> <span>↗</span>
          </a>
        </div>
      </div>
    </div>
    <div class="hero-note">
      <span></span>
      <span>Regulated Legal Practice</span>
    </div>
  </section>
<% } %>

<section class="stats"<%- sectionStyle('home_stats') %>>
  <div class="container stats-grid">
    <div class="stat">
      <i>01</i>
      <span class="stat-number"><%= setting('stat_consultations', '1,400+') %></span>
      <span>Consultations completed</span>
    </div>
    <div class="stat">
      <i>02</i>
      <span class="stat-number"><%= setting('stat_cases', '980+') %></span>
      <span>Successful applications</span>
    </div>
    <div class="stat">
      <i>03</i>
      <span class="stat-number"><%= setting('stat_success', '99.2%') %></span>
      <span>Positive client outcome rate</span>
    </div>
    <div class="stat">
      <i>04</i>
      <span class="stat-number"><%= setting('stat_reviews', '5.0') %> <b>★</b></span>
      <span>Verified client rating</span>
    </div>
  </div>
</section>

<section class="section client-marquee-section"<%- sectionStyle('home_clients') %>>
  <div class="container text-center">
    <h2 class="client-section-heading"><%= setting('clients_title', 'Our Client') %></h2>
  </div>
  <div class="client-marquee-container">
    <div class="client-marquee-track">
      <% const logoList = (typeof clients !== 'undefined' && clients && clients.length > 0) ? clients : []; %>
      <% for (let repeat = 0; repeat < 4; repeat++) { %>
        <div class="client-marquee-group" aria-hidden="<%= repeat > 0 ? 'true' : 'false' %>">
          <% logoList.forEach(client => { %>
            <div class="client-logo-item" title="<%= client.name %>">
              <% if (client.website_url) { %>
                <a href="<%= client.website_url %>" target="_blank" rel="noopener noreferrer" class="client-logo-link">
              <% } %>
              
              <% if (client.image_path) { %>
                <img src="<%= client.image_path %>" alt="<%= client.name %>" class="client-logo-img">
              <% } else { %>
                <span class="client-logo-text"><%= client.name %></span>
              <% } %>

              <% if (client.website_url) { %>
                </a>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section feature-section"<%- sectionStyle('home_services') %>>
  <div class="container">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">PRACTICE AREAS</p>
        <h2>Areas of <em>expertise</em></h2>
      </div>
      <a class="text-link" href="/services.php">View all services <span>→</span></a>
    </div>
    <div class="features">
      <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
        <% services.slice(0, 4).forEach((service, idx) => { %>
          <div class="feature">
            <span>0<%= idx + 1 %> / <%= (service.tagline || 'Specialism').toUpperCase() %></span>
            <h3><%= service.title %></h3>
            <p><%= service.excerpt || service.content.substring(0, 110) + '...' %></p>
            <a href="/contact.php?topic=<%= encodeURIComponent(service.title) %>#consultation">
              <span>Book consult</span>
              <b>→</b>
            </a>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<% if (typeof testimonials !== 'undefined' && testimonials && testimonials.length > 0) { %>
  <section class="section testimonials"<%- sectionStyle('home_testimonials') %>>
    <div class="container">
      <div class="section-heading split">
        <div>
          <p class="eyebrow" style="color: #e3c995;">CLIENT EXPERIENCES</p>
          <h2 style="color: #ffffff;">What our <em>clients say</em></h2>
        </div>
        <div class="slider-controls">
          <button type="button" aria-label="Previous testimonial">←</button>
          <button type="button" aria-label="Next testimonial">→</button>
        </div>
      </div>
      <div class="testimonial-track">
        <% testimonials.forEach(t => { %>
          <div class="testimonial">
            <div class="quote-mark">“</div>
            <p><%= t.quote %></p>
            <div class="person">
              <% if (t.image_path) { %>
                <img src="<%= t.image_path %>" alt="<%= t.client_name %>">
              <% } else { %>
                <span><%= t.client_name.charAt(0) %></span>
              <% } %>
              <div>
                <strong><%= t.client_name %></strong>
                <small><%= t.client_role || 'Client' %></small>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<% if (typeof articles !== 'undefined' && articles && articles.length > 0) { %>
  <section class="section articles"<%- sectionStyle('home_articles') %>>
    <div class="container">
      <div class="section-heading split">
        <div>
          <p class="eyebrow">INSIGHTS & GUIDANCE</p>
          <h2>Recent <em>publications</em></h2>
        </div>
        <a class="text-link" href="/articles.php">Browse all insights <span>→</span></a>
      </div>
      <div class="article-grid">
        <% articles.forEach(art => { %>
          <article class="article-card">
            <% if (art.image_path) { %>
              <img src="<%= art.image_path %>" alt="<%= art.title %>">
            <% } else { %>
              <div class="article-image">
                <span><%= (art.category || 'Law').toUpperCase() %></span>
              </div>
            <% } %>
            <p class="article-meta"><%= art.category %> • <%= formatDate(art.published_at) %></p>
            <h3><%= art.title %></h3>
            <p><%= art.excerpt %></p>
            <a class="text-link" href="/article.php?slug=<%= encodeURIComponent(art.slug) %>">Read full article <span>→</span></a>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
