<%- include('partials/header') %>

<section class="inner-hero"<%- sectionStyle('articles_hero') %>>
  <div class="container">
    <p class="eyebrow">PRACTICE INSIGHTS</p>
    <h1>Legal analysis.<br><em>Immigration updates.</em></h1>
    <p>Explore practical commentary, Home Office policy changes, case preparation guides, and updates from our casework team.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (typeof articles !== 'undefined' && articles && articles.length > 0) { %>
      <div class="article-grid article-grid-full">
        <% articles.forEach(art => { %>
          <article class="article-card">
            <% if (art.image_path) { %>
              <img src="<%= art.image_path %>" alt="<%= art.title %>">
            <% } else { %>
              <div class="article-image">
                <span><%= (art.category || 'Law').toUpperCase() %></span>
              </div>
            <% } %>
            <p class="article-meta"><%= art.category %> • <%= formatDate(art.published_at) %></p>
            <h3><%= art.title %></h3>
            <p><%= art.excerpt %></p>
            <a class="text-link" href="/article.php?slug=<%= encodeURIComponent(art.slug) %>">Read full article <span>→</span></a>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <p style="text-align: center; color: #6b8284; padding: 40px 0;">No articles published at this time.</p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
