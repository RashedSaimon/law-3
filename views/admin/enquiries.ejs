<%- include('partials/header') %>

<section class="admin-card">
  <div class="card-heading">
    <div>
      <p>Inbound Consultation Requests</p>
      <h2>Client Enquiries (<%= enquiries.length %>)</h2>
    </div>
  </div>

  <% if (typeof enquiries !== 'undefined' && enquiries && enquiries.length > 0) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Client Name</th>
          <th>Contact Details</th>
          <th>Service / Topic</th>
          <th>Message & Details</th>
          <th>Status</th>
          <th>Update Status</th>
        </tr>
      </thead>
      <tbody>
        <% enquiries.forEach(enq => { %>
          <tr>
            <td style="white-space: nowrap;"><%= formatShortDate(enq.created_at) %></td>
            <td><strong><%= enq.first_name %> <%= enq.last_name %></strong></td>
            <td>
              <a href="mailto:<%= enq.email %>" style="color: #927541; font-weight: 600; text-decoration: underline;"><%= enq.email %></a>
              <% if (enq.phone) { %>
                <div style="font-size: 12px; color: #6b8284; margin-top: 2px;"><%= enq.phone %></div>
              <% } %>
            </td>
            <td>
              <span class="badge" style="background: #e6eef0; color: #102b2d;"><%= enq.service || 'General Consultation' %></span>
            </td>
            <td style="max-width: 320px; line-height: 1.4; font-size: 13px;">
              <p style="margin: 0; white-space: pre-wrap; color: #2d3748;"><%= enq.message %></p>
            </td>
            <td>
              <span class="badge badge-<%= enq.status %>"><%= enq.status %></span>
            </td>
            <td>
              <form method="post" action="/admin/content.php?type=enquiries" style="display: flex; gap: 6px; align-items: center;">
                <input type="hidden" name="action" value="status">
                <input type="hidden" name="id" value="<%= enq.id %>">
                <select name="status" onchange="this.form.submit()" style="padding: 4px 8px; font-size: 12px; border-radius: 4px; border: 1px solid #d5cbba;">
                  <option value="new" <%= enq.status === 'new' ? 'selected' : '' %>>New</option>
                  <option value="contacted" <%= enq.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
                  <option value="closed" <%= enq.status === 'closed' ? 'selected' : '' %>>Closed</option>
                </select>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p style="color: #6b8284; padding: 40px 0; text-align: center;">No client enquiries recorded yet.</p>
  <% } %>
</section>

<%- include('partials/footer') %>
