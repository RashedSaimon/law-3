<%- include('partials/header') %>

<section class="admin-card form-card">
  <div class="card-heading">
    <div>
      <p><%= id ? 'Edit item' : 'Create item' %></p>
      <h2><%= config.label %></h2>
    </div>
    <a href="/admin/content.php?type=<%= type %>">← Back to list</a>
  </div>
  <form class="editor-form" method="post" action="/admin/content.php?type=<%= type %>" enctype="multipart/form-data">
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="id" value="<%= id || 0 %>">

    <% Object.entries(config.fields).forEach(([field, label]) => { %>
      <% 
        let value = item ? item[field] : (field === 'is_active' ? 1 : ''); 
        const isWide = ['excerpt', 'content', 'bio', 'quote', 'body', 'text'].includes(field);
      %>
      <label class="<%= isWide ? 'wide' : '' %>">
        <%= label %>

        <% if (['content', 'body'].includes(field)) { %>
          <div class="quill-editor-wrapper" style="margin-top: 8px;">
            <div id="quill-toolbar-<%= field %>" class="quill-toolbar">
              <span class="ql-formats">
                <select class="ql-header">
                  <option value="1">Heading 1 (Main)</option>
                  <option value="2">Heading 2 (Section)</option>
                  <option value="3">Heading 3 (Sub-heading)</option>
                  <option value="4">Heading 4</option>
                  <option selected>Normal Text</option>
                </select>
                <select class="ql-size">
                  <option value="small">Small</option>
                  <option selected>Normal</option>
                  <option value="large">Large</option>
                  <option value="huge">Huge</option>
                </select>
              </span>
              <span class="ql-formats">
                <button class="ql-bold" title="Bold"></button>
                <button class="ql-italic" title="Italic"></button>
                <button class="ql-underline" title="Underline"></button>
                <button class="ql-strike" title="Strikethrough"></button>
              </span>
              <span class="ql-formats">
                <select class="ql-color" title="Text Color"></select>
                <select class="ql-background" title="Highlight Color"></select>
              </span>
              <span class="ql-formats">
                <select class="ql-align" title="Text Alignment"></select>
              </span>
              <span class="ql-formats">
                <button class="ql-list" value="ordered" title="Numbered List"></button>
                <button class="ql-list" value="bullet" title="Bullet List"></button>
                <button class="ql-list" value="check" title="Checklist"></button>
              </span>
              <span class="ql-formats">
                <button class="ql-indent" value="-1" title="Outdent"></button>
                <button class="ql-indent" value="+1" title="Indent"></button>
              </span>
              <span class="ql-formats">
                <button class="ql-blockquote" title="Quote Block"></button>
                <button class="ql-code-block" title="Code Block"></button>
              </span>
              <span class="ql-formats">
                <button class="ql-link" title="Insert Link"></button>
                <button class="ql-image" title="Insert Image"></button>
                <button class="ql-clean" title="Clear Formatting"></button>
              </span>
            </div>
            <div id="quill-editor-<%= field %>" style="min-height: 260px; background: #ffffff; font-family: var(--sans); font-size: 15px; border-radius: 0 0 4px 4px;"><%- value || '' %></div>
            <textarea name="<%= field %>" id="input-<%= field %>" style="display: none;"><%= value || '' %></textarea>
          </div>
        <% } else if (['bio', 'quote', 'excerpt', 'text'].includes(field)) { %>
          <textarea name="<%= field %>" rows="4"><%= value || '' %></textarea>
        <% } else if (field === 'is_active') { %>
          <span class="toggle">
            <input type="checkbox" name="is_active" value="1" <%= value ? 'checked' : '' %>> Show this on the website
          </span>
        <% } else if (field === 'page_id') { %>
          <select name="page_id" id="hero_page_id_select">
            <option value="0" <%= !value || Number(value) === 0 ? 'selected' : '' %>>-- Select Linked Page --</option>
            <% if (typeof allPages !== 'undefined' && allPages && allPages.length > 0) { %>
              <% allPages.forEach(p => { %>
                <option value="<%= p.id %>" <%= Number(value) === Number(p.id) ? 'selected' : '' %>>
                  <%= p.title %> (/page.php?slug=<%= p.slug %>)
                </option>
              <% }); %>
            <% } %>
          </select>
          <small class="form-hint" style="display: block; margin-top: 6px; color: #6b8284;">Select which site page this option opens when clicked. (Or leave as "-- Select Linked Page --" and enter a custom URL below).</small>
        <% } else if (field === 'parent_menu') { %>
          <select name="parent_menu" id="parent_menu_select" onchange="updateParentPageOptions()">
            <option value="personal_immigration" <%= value === 'personal_immigration' ? 'selected' : '' %>>Personal Immigration (Layer 1)</option>
            <option value="business_immigrations" <%= value === 'business_immigrations' ? 'selected' : '' %>>Business Immigration (Layer 1)</option>
            <option value="none" <%= value === 'none' || !value ? 'selected' : '' %>>None (Standalone / Footer only)</option>
          </select>
        <% } else if (field === 'parent_page_id') { %>
          <select name="parent_page_id" id="parent_page_id_select">
            <option value="0" <%= !value || Number(value) === 0 ? 'selected' : '' %>>[None - This is a Main Submenu Category (Layer 2)]</option>
            <% if (typeof allPages !== 'undefined' && allPages && allPages.length > 0) { %>
              <% allPages.filter(p => (!item || p.id !== item.id) && (!p.parent_page_id || Number(p.parent_page_id) === 0)).forEach(p => { %>
                <option value="<%= p.id %>" data-parent-menu="<%= p.parent_menu || 'none' %>" <%= Number(value) === Number(p.id) ? 'selected' : '' %>>
                  <%= p.parent_menu === 'personal_immigration' ? '[Personal]' : p.parent_menu === 'business_immigrations' ? '[Business]' : '[Other]' %> Layer 2: <%= p.title %>
                </option>
              <% }); %>
            <% } %>
          </select>
          <small class="form-hint">Choose a Layer 2 parent page if this page belongs as a Layer 3 sub-page under it.</small>
        <% } else if (field === 'icon') { %>
          <div class="icon-picker-group">
            <input type="hidden" name="icon" id="selected-icon-input" value="<%= value || (type === 'pages' ? 'document' : 'home') %>">
            <div class="icon-selector-grid">
              <% 
                const availableIcons = [
                  { key: 'home', label: 'Home' },
                  { key: 'list', label: 'List' },
                  { key: 'database', label: 'Database' },
                  { key: 'contact', label: 'Contact' },
                  { key: 'gift', label: 'Gift / Surgery' },
                  { key: 'document', label: 'Document' },
                  { key: 'briefcase', label: 'Briefcase' },
                  { key: 'shield', label: 'Shield' },
                  { key: 'award', label: 'Award' },
                  { key: 'star', label: 'Star' },
                  { key: 'user', label: 'User' },
                  { key: 'scale', label: 'Scale / Legal' }
                ];
                const currentIcon = value || (type === 'pages' ? 'document' : 'home');
              %>
              <% availableIcons.forEach(ic => { %>
                <button type="button" class="icon-choice-btn <%= currentIcon === ic.key ? 'active' : '' %>" data-icon="<%= ic.key %>" onclick="selectMenuIcon('<%= ic.key %>')">
                  <span class="icon-choice-svg"><%- renderMenuIcon(ic.key) %></span>
                  <span class="icon-choice-name"><%= ic.label %></span>
                </button>
              <% }); %>
            </div>
          </div>
        <% } else if (field === 'status') { %>
          <select name="status">
            <option value="draft" <%= value === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="published" <%= value === 'published' || !value ? 'selected' : '' %>>Published</option>
          </select>
        <% } else if (field === 'published_at') { %>
          <input type="datetime-local" name="published_at" value="<%= value ? new Date(value).toISOString().slice(0,16) : new Date().toISOString().slice(0,16) %>">
        <% } else if (field === 'sort_order') { %>
          <input type="number" name="sort_order" value="<%= value !== undefined && value !== '' ? value : 0 %>">
        <% } else { %>
          <input name="<%= field %>" value="<%= value || '' %>" <%= field === 'title' || field === 'name' ? 'required' : '' %>>
        <% } %>
      </label>
    <% }); %>

    <label class="wide">
      <%= type === 'pages' ? 'Page banner image' : (type === 'clients' ? 'Client / Partner Logo' : 'Image (JPG, PNG, SVG or WebP)') %>
      <small class="form-hint"><%= config.image_help || 'JPG, PNG, SVG or WebP; maximum file size 4 MB.' %></small>
      <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/svg+xml">
    </label>

    <% if (item && item.image_path) { %>
      <div style="grid-column: 1/-1;">
        <p style="font-size: 11px; margin-bottom: 5px; color: #788a8b;">Current Image:</p>
        <img class="image-preview" src="<%= item.image_path %>" alt="Current image">
      </div>
    <% } %>

    <div class="form-actions" style="display: flex; justify-content: space-between; align-items: center;">
      <button type="submit">Save item →</button>
      <% if (id && item) { %>
        <button type="button" class="btn-danger-outline" onclick="openDeleteModal('<%= type %>', '<%= id %>', '<%= (item.title || item.label || item.name || item.client_name || 'this item').replace(/'/g, "\\'") %>')">Delete this <%= type === 'menus' ? 'menu item' : 'item' %></button>
      <% } %>
    </div>
  </form>
</section>

<% if (id && item) { %>
  <!-- Custom Delete Confirmation Modal (Iframe-safe) -->
  <div id="deleteModal" class="admin-modal-backdrop" style="display:none;" onclick="if(event.target===this) closeDeleteModal()">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3>Confirm Deletion</h3>
        <button type="button" class="modal-close-btn" onclick="closeDeleteModal()">&times;</button>
      </div>
      <div class="admin-modal-body">
        <p>Are you sure you want to permanently delete <strong id="deleteItemTitle">this item</strong>?</p>
        <small style="display:block; margin-top: 8px; color: #788a8b;">This will remove the item from the live website and database.</small>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="modal-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
        <form id="deleteModalForm" method="post" action="/admin/content.php?type=<%= type %>" style="margin: 0;">
          <input type="hidden" name="action" value="delete">
          <input type="hidden" name="type" id="modalDeleteType" value="<%= type %>">
          <input type="hidden" name="id" id="modalDeleteId" value="<%= id %>">
          <button type="submit" class="modal-btn-confirm">Yes, Delete Item</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openDeleteModal(type, id, title) {
      var modal = document.getElementById('deleteModal');
      var titleEl = document.getElementById('deleteItemTitle');
      if (modal) {
        if (titleEl) titleEl.textContent = '"' + title + '"';
        modal.style.display = 'flex';
      }
    }

    function closeDeleteModal() {
      var modal = document.getElementById('deleteModal');
      if (modal) {
        modal.style.display = 'none';
      }
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDeleteModal();
    });
  </script>
<% } %>

<script>
  function updateParentPageOptions() {
    var menuSelect = document.getElementById('parent_menu_select');
    var parentPageSelect = document.getElementById('parent_page_id_select');
    if (!menuSelect || !parentPageSelect) return;
    
    var selectedMenu = menuSelect.value;
    var options = parentPageSelect.querySelectorAll('option');
    options.forEach(function(opt) {
      if (opt.value === '0') return; // Keep the None option always visible
      var optParentMenu = opt.getAttribute('data-parent-menu');
      if (selectedMenu === 'none' || !selectedMenu || optParentMenu === selectedMenu) {
        opt.style.display = '';
      } else {
        opt.style.display = 'none';
      }
    });
  }

  function selectMenuIcon(iconKey) {
    var input = document.getElementById('selected-icon-input');
    if (input) {
      input.value = iconKey;
    }
    var buttons = document.querySelectorAll('.icon-choice-btn');
    buttons.forEach(function(btn) {
      if (btn.getAttribute('data-icon') === iconKey) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  // Initialize Quill Rich Text Editors if present
  var quillInstances = {};
  document.addEventListener('DOMContentLoaded', function() {
    updateParentPageOptions();

    ['content', 'body'].forEach(function(fieldName) {
      var editorElem = document.getElementById('quill-editor-' + fieldName);
      var toolbarElem = document.getElementById('quill-toolbar-' + fieldName);
      var hiddenInput = document.getElementById('input-' + fieldName);

      if (editorElem && toolbarElem && typeof Quill !== 'undefined') {
        var quill = new Quill(editorElem, {
          modules: {
            toolbar: toolbarElem
          },
          theme: 'snow',
          placeholder: 'Compose rich, formatted content just like Word (Headings, bullet lists, bold text, links, highlights)...'
        });
        quillInstances[fieldName] = quill;

        // Auto sync on changes
        quill.on('text-change', function() {
          if (hiddenInput) {
            hiddenInput.value = editorElem.querySelector('.ql-editor').innerHTML;
          }
        });
      }
    });

    // Final sync before form submit
    var form = document.querySelector('.editor-form');
    if (form) {
      form.addEventListener('submit', function() {
        ['content', 'body'].forEach(function(fieldName) {
          var editorElem = document.getElementById('quill-editor-' + fieldName);
          var hiddenInput = document.getElementById('input-' + fieldName);
          if (editorElem && hiddenInput) {
            var qlEditor = editorElem.querySelector('.ql-editor');
            if (qlEditor) {
              hiddenInput.value = qlEditor.innerHTML;
            }
          }
        });
      });
    }
  });
</script>

<%- include('partials/footer') %>
