<%- include('partials/header') %>

<section class="section article-page">
  <div class="container">
    <div class="article-content">
      <a class="back-link" href="/articles.php">← Back to all insights</a>
      <p class="article-meta"><%= article.category || 'Information' %> • <%= formatDate(article.published_at) %></p>
      <h1><%= article.title %></h1>
      
      <% if (article.excerpt) { %>
        <p class="article-standfirst"><%= article.excerpt %></p>
      <% } %>

      <% if (article.image_path) { %>
        <img class="article-hero-image" src="<%= article.image_path %>" alt="<%= article.title %>">
      <% } %>

      <div class="prose rich-content">
        <%- article.body ? article.body.replace(/\n\n/g, '<p></p>').replace(/\n/g, '<br>') : '' %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
